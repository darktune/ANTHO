# ==============================================================================
# ANTHO ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env or set these variables in your Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE (PRISMA CONNECTION POOLING)
# In Supabase Dashboard: Project Settings > Database > Connection string
# ------------------------------------------------------------------------------
# Transaction Pooler (port 6543) - Used for serverless queries with pgbouncer
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Mode / Direct Connection (port 5432) - Used for Prisma migrations (db push / migrate)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS
# In Supabase Dashboard: Project Settings > API
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Public Supabase Anon / Publishable Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Secret Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. AUTH & ADMIN
# ------------------------------------------------------------------------------
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-strong-random-secret"
NEXTAUTH_URL="https://your-antho-deployment.vercel.app"

ADMIN_EMAIL="admin@antho.ng"
ADMIN_PASSWORD="change-me-in-production"

# ------------------------------------------------------------------------------
# 4. PAYMENTS (PAYSTACK)
# In Paystack Dashboard: Settings > API Keys & Webhooks
# ------------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ------------------------------------------------------------------------------
# 5. PUBLIC STOREFRONT SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-antho-deployment.vercel.app"
NEXT_PUBLIC_SITE_NAME="ANTHO"
NEXT_PUBLIC_WHATSAPP_NUMBER="+2348000000000"
